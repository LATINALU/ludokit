{
  "name": "ludokit",
  "version": "2.0.0",
  "description": "Librería de MECÁNICAS de videojuegos para cualquier género (RPG de acción, MMO, MOBA, shooters 3D, extracción, supervivencia, zombis, carreras, estrategia, turnos, cartas, plataformas...): reglas puras sin números de ningún juego, curvas de escalado sin tope, 58 modelos combinables, asistente de preguntas, catálogos de datos propios y netcode.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./archivos": "./src/infraestructura/persistencia/almacen-archivos.ts",
    "./modelos": "./src/modelos/index.ts",
    "./datos": "./src/datos/index.ts",
    "./vfx/*": "./terceros/vfx/*"
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "test": "node --test test/*.test.ts test/*.test.mjs",
    "tipos": "tsc -p tsconfig.json",
    "ejemplo:economia": "node ejemplos/economia.ts",
    "ejemplo:plataformas": "node ejemplos/plataformas.ts",
    "ejemplo:mmo": "node ejemplos/mmo.ts",
    "ejemplo:sonidos": "node ejemplos/sonidos.ts",
    "verificar": "npm run tipos && npm test && npm run indice",
    "crear": "node herramientas/crear.ts",
    "indice": "node herramientas/indice.ts",
    "ejemplo:shooter3d": "node ejemplos/shooter3d.ts",
    "ejemplo:asistente": "node ejemplos/asistente.ts",
    "golden": "node vectores/golden.ts",
    "rendimiento": "node ejemplos/rendimiento.ts"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "devDependencies": {
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3"
  }
}